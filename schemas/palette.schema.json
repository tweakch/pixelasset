{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelasset.local/schemas/palette.schema.json",
  "title": "Pixelasset palette (role → RGB)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "tile_unit", "roles"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "tile_unit": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "required": [
        "OUTLINE",
        "SHADOW_DARK",
        "SHADOW",
        "BASE",
        "LIGHT",
        "HIGHLIGHT",
        "ACCENT"
      ]
    }
  }
}
