{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelasset.local/schemas/validation.schema.json",
  "title": "Pixelasset machine-readable validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset", "status", "errors", "warnings"],
  "properties": {
    "asset": { "type": "string" },
    "status": { "type": "string", "enum": ["PASSED", "FAILED"] },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "info": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["ERROR", "WARNING", "INFO"] },
        "message": { "type": "string" },
        "frame": { "type": ["integer", "null"] },
        "pixels": { "type": ["number", "null"] }
      }
    }
  }
}
