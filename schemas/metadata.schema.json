{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelasset.local/schemas/metadata.schema.json",
  "title": "Pixelasset engine-agnostic metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "frame_size",
    "frame_count",
    "animations",
    "anchors",
    "palette_version",
    "pipeline_version",
    "construction_path"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "family": { "type": "string" },
    "variant": { "type": "string" },
    "category": { "type": "string" },
    "frame_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "frame_count": { "type": "integer", "minimum": 1 },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "frames", "fps", "loop", "order"],
        "properties": {
          "name": { "type": "string" },
          "frames": { "type": "integer" },
          "fps": { "type": "number" },
          "loop": { "type": "boolean" },
          "order": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "anchors": {
      "type": "object",
      "required": ["origin", "points"],
      "properties": {
        "origin": { "type": "string" },
        "points": { "type": "object" }
      }
    },
    "palette_name": { "type": "string" },
    "palette_version": { "type": "string" },
    "style_version": { "type": "string" },
    "pipeline_version": { "type": "string" },
    "asset_version": { "type": "string" },
    "construction_path": { "type": "string", "enum": ["A", "B", "C"] },
    "view": { "type": "string" },
    "reproducibility": { "$ref": "#/$defs/reproducibility" }
  },
  "$defs": {
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "pipeline_version",
        "style_version",
        "palette_version",
        "asset_version",
        "construction_path",
        "source_hash",
        "created_at"
      ],
      "properties": {
        "asset_id": { "type": "string" },
        "pipeline_version": { "type": "string" },
        "style_version": { "type": "string" },
        "palette_version": { "type": "string" },
        "asset_version": { "type": "string" },
        "construction_path": { "type": "string" },
        "generator": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "prompt": { "type": ["string", "null"] },
        "seed": { "type": ["integer", "null"] },
        "concept_hash": { "type": ["string", "null"] },
        "source_hash": { "type": "string" },
        "created_at": { "type": "string" }
      }
    }
  }
}
